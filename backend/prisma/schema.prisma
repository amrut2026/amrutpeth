// ============================================================
// FoodMart PoC - Prisma schema (PostgreSQL)
// Run: npx prisma migrate dev --name receipt_confirmation_workflow
// ============================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN // manufacturer / platform owner
  ORGANISATION // login tied to an Organisation (Mahamandal/Federation/Association) itself
  DEALER
  RETAILER
}

enum OwnerType {
  DEALER
  RETAILER
}

enum PaymentMode {
  CASH
  UPI
  CARD
}

enum CustomerType {
  CASH
  RETAILER
}

enum VoucherStatus {
  OPEN
  PARTIALLY_PAID
  PAID
}

// A Receipt starts TO_BE_CONFIRMED the moment a retailer submits a payment
// (see receipts.js POST /) and only becomes PARTIALLY_PAID or PAID once
// the dealer confirms it actually arrived (PATCH /:id/confirm) — mirrors
// the terminal values of VoucherStatus deliberately (the receipt's final
// status and the voucher's resulting status are set to the same value in
// that same confirm step), but is a separate enum because a Receipt can
// additionally sit in the pending TO_BE_CONFIRMED state, which a Voucher
// itself never does.
enum ReceiptStatus {
  TO_BE_CONFIRMED
  PARTIALLY_PAID
  PAID
}

// RECEIVABLE: dealer -> retailer (retailer owes the dealer for a sale, see
// sales.js). PAYABLE: supplier -> dealer (dealer owes the supplier for a
// purchase, see purchases.js) — mirrors a RECEIVABLE voucher from the
// supplier's side (supplier "sold", dealer "bought"), but is always raised
// already PAID: the dealer is assumed to settle with the supplier directly
// and hand back a receipt outside this system, so there's no Receipt-style
// confirmation step for this type (Receipt stays scoped to retailers only).
enum VoucherType {
  RECEIVABLE
  PAYABLE
}

// Purchase review workflow forks by role after IN_REVIEW:
//   DEALER (buying from a supplier):     PENDING -> IN_REVIEW -> CONFIRMED
//   RETAILER (buying from their dealer): PENDING -> IN_REVIEW -> ORDERED
//     -> IN_TRANSIT -> RECEIVED
// ORDERED means the retailer has placed the order — a mirror row is created
// in the dealer's own Sale table at that point (see Purchase.linkedSale)
// so it shows up in their normal sales workflow. IN_TRANSIT means the
// dealer has dispatched it: their own inventory has already been
// decremented, via the linked Sale's dispatch (see sales.js PATCH
// /:id/dispatch) — that route is the only thing allowed to make this
// transition, since it also requires picking a batch per item. RECEIVED is
// the terminal state where the retailer's own inventory finally gets
// credited (see purchases.js PATCH /:id/status).
enum PurchaseStatus {
  PENDING
  IN_REVIEW
  CONFIRMED
  ORDERED
  IN_TRANSIT
  RECEIVED
}

// A regular POS sale (walk-in cash sale, a dealer selling on the spot to a
// retailer, or a card/UPI terminal webhook) completes immediately and is
// COMPLETED from the moment it's created — every Sale made directly
// through sales.js's createSale() is this. IN_PENDING and DISPATCHED only
// apply to a Sale that was auto-created from a retailer's purchase order
// once it reaches ORDERED (see PurchaseStatus / Purchase.linkedSale):
// IN_PENDING while it's waiting on the dealer to fulfil it (no batch
// chosen yet, totalAmount/paymentMode are still null), DISPATCHED once the
// dealer has picked a batch per item and their inventory has been
// decremented.
enum SaleStatus {
  COMPLETED
  IN_PENDING
  DISPATCHED
}

// ---------------- Users / Auth ----------------
model User {
  id             Int           @id @default(autoincrement())
  username       String        @unique
  password       String // bcrypt hash
  role           Role
  dealerId       Int?
  retailerId     Int?
  organisationId Int?
  dealer         Dealer?       @relation(fields: [dealerId], references: [id])
  retailer       Retailer?     @relation(fields: [retailerId], references: [id])
  organisation   Organisation? @relation(fields: [organisationId], references: [orgId])
  createdAt      DateTime      @default(now())
}

// ---------------- Divisions (geographic/business areas) ----------------
// Used to group dealers and suppliers/manufacturers by area of establishment.
model Division {
  id          Int      @id @default(autoincrement())
  name        String   @unique
  description String?
  // Soft-delete flag — divisions are never hard-deleted (dealers/suppliers
  // reference them), just deactivated. See divisions.js PATCH /:id/active.
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())

  dealers   Dealer[]
  suppliers Supplier[]
}

// ---------------- Dealer ----------------
model Dealer {
  id             Int          @id @default(autoincrement())
  name           String
  address        String
  contactNumber  String
  gstNumber      String
  divisionId     Int?
  division       Division?    @relation(fields: [divisionId], references: [id])
  organisationId Int          @default(1)
  organisation   Organisation @relation(fields: [organisationId], references: [orgId])
  createdAt      DateTime     @default(now())

  bankAccounts           DealerBankAccount[]
  retailers              Retailer[]
  users                  User[]
  products               Product[]
  productCategories      ProductCategory[]
  inventory              Inventory[]         @relation("DealerInventory")
  purchases              Purchase[]          @relation("DealerPurchases")
  purchasesFromRetailers Purchase[]          @relation("PurchaseFromDealer")
  sales                  Sale[]              @relation("DealerSales")
  vouchers               Voucher[]
  payments               Payment[]
}

model DealerBankAccount {
  id            Int    @id @default(autoincrement())
  dealerId      Int
  dealer        Dealer @relation(fields: [dealerId], references: [id])
  accountNumber String
  ifsc          String
  bankName      String
}

// ---------------- Retailer ----------------
model Retailer {
  id              Int      @id @default(autoincrement())
  name            String
  address         String
  contactNumber   String
  gstNumber       String
  primaryDealerId Int
  dealer          Dealer   @relation(fields: [primaryDealerId], references: [id])
  createdAt       DateTime @default(now())

  bankAccounts RetailerBankAccount[]
  users        User[]
  inventory    Inventory[]           @relation("RetailerInventory")
  purchases    Purchase[]            @relation("RetailerPurchases")
  sales        Sale[]                @relation("RetailerSales")
  vouchers     Voucher[]
  receipts     Receipt[]
  payments     Payment[]
}

model RetailerBankAccount {
  id            Int      @id @default(autoincrement())
  retailerId    Int
  retailer      Retailer @relation(fields: [retailerId], references: [id])
  accountNumber String
  ifsc          String
  bankName      String
}

// ---------------- Product Catalog ----------------
// Categories are created by dealers and scoped to them — a DEALER only sees
// and manages their own categories, while ADMIN can see every dealer's
// categories (read-only) across the whole platform.
model ProductCategory {
  id          Int       @id @default(autoincrement())
  name        String
  description String?
  dealerId    Int
  dealer      Dealer    @relation(fields: [dealerId], references: [id])
  products    Product[]
}

// Product master catalog. Managed centrally by ADMIN only — dealers and
// retailers get stock into their own inventory via the Purchases module,
// they do not own or edit catalog entries themselves.
// Note: pricing, MRP, dates, and batch name are NOT here — those vary per
// batch purchased and live on PurchaseItem instead. The barcode identifies
// the product itself and stays the same across every purchase/batch.
model Product {
  id         Int             @id @default(autoincrement())
  categoryId Int
  category   ProductCategory @relation(fields: [categoryId], references: [id])
  supplierId Int?
  supplier   Supplier?       @relation(fields: [supplierId], references: [id])
  dealerId   Int // the dealer that created/owns this product — retailers may
  dealer     Dealer          @relation(fields: [dealerId], references: [id])
  // only purchase or sell it via that dealer, and other dealers can't see it
  name       String
  sizeWeight String
  fssaiCode  String
  barcode    String          @unique // encoded value for barcode/QR - stable, never regenerated

  createdAt     DateTime       @default(now())
  inventory     Inventory[]
  saleItems     SaleItem[]
  purchaseItems PurchaseItem[]
}

// Suppliers / manufacturers that dealers (or retailers) purchase stock from.
// Managed centrally by ADMIN.
model Supplier {
  id            Int       @id @default(autoincrement())
  name          String
  address       String
  contactNumber String
  gstNumber     String
  divisionId    Int?
  division      Division? @relation(fields: [divisionId], references: [id])
  createdAt     DateTime  @default(now())

  bankAccounts SupplierBankAccount[]
  purchases    Purchase[]
  products     Product[]
  vouchers     Voucher[]
  payments     Payment[]
}

model SupplierBankAccount {
  id            Int      @id @default(autoincrement())
  supplierId    Int
  supplier      Supplier @relation(fields: [supplierId], references: [id])
  accountNumber String
  ifsc          String
  bankName      String
}

// ---------------- Inventory ----------------
// One row per product + owner + BATCH. A product with stock from two
// different accepted purchases (different batchName) now has two rows here,
// each with its own quantity and its own pricing/dates from that specific
// PurchaseItem (see purchases.js /:id/status, which upserts per batch
// instead of collapsing into a single row). This lets a seller choose which
// batch to sell from at sale time (see sales.js) rather than always selling
// at "whatever the latest purchase price was."
model Inventory {
  id           Int       @id @default(autoincrement())
  productId    Int
  product      Product   @relation(fields: [productId], references: [id])
  ownerType    OwnerType
  dealerId     Int?
  retailerId   Int?
  dealer       Dealer?   @relation("DealerInventory", fields: [dealerId], references: [id])
  retailer     Retailer? @relation("RetailerInventory", fields: [retailerId], references: [id])
  quantity     Int       @default(0)
  reorderLevel Int       @default(10)

  // -- pricing/batch fields, carried from this specific PurchaseItem --
  rate                 Decimal   @default(0) @db.Decimal(10, 2) // cost price paid per unit, this batch
  dealerCommission     Decimal   @default(0) @db.Decimal(5, 2) // % used to derive sellingPrice
  sellingPrice         Decimal   @default(0) @db.Decimal(10, 2) // dealer -> retailer price
  discount             Decimal   @default(0) @db.Decimal(10, 2) // % used to derive retailerSellingPrice
  mrp                  Decimal   @default(0) @db.Decimal(10, 2)
  retailerSellingPrice Decimal   @default(0) @db.Decimal(10, 2) // retailer -> end customer / dealer cash-sale price
  manufacturingDate    DateTime?
  expiryDate           DateTime?
  batchName            String    @default("")

  updatedAt DateTime @updatedAt

  // batchName is part of the identity now — same product+owner can have
  // multiple batch rows. batchName defaults to "" rather than being
  // nullable because Postgres treats NULLs as distinct for uniqueness
  // purposes, which would let duplicate "no batch" rows slip through.
  @@unique([productId, ownerType, dealerId, retailerId, batchName])
}

// ---------------- Purchases / Inwards ----------------
// supplierId is set when a DEALER buys from a manufacturer/supplier.
// sourceDealerId is set when a RETAILER buys from their primary dealer.
// Exactly one of the two is populated, depending on ownerType.
model Purchase {
  id             Int            @id @default(autoincrement())
  ownerType      OwnerType
  dealerId       Int?
  retailerId     Int?
  dealer         Dealer?        @relation("DealerPurchases", fields: [dealerId], references: [id])
  retailer       Retailer?      @relation("RetailerPurchases", fields: [retailerId], references: [id])
  supplierId     Int?
  supplier       Supplier?      @relation(fields: [supplierId], references: [id])
  sourceDealerId Int?
  sourceDealer   Dealer?        @relation("PurchaseFromDealer", fields: [sourceDealerId], references: [id])
  date           DateTime       @default(now())
  status         PurchaseStatus @default(PENDING)
  items          PurchaseItem[]

  // Set when this is a retailer's purchase order and it reaches ORDERED —
  // points at the mirror Sale row created in the source dealer's own Sale
  // table (see purchases.js PATCH /:id/status and sales.js PATCH
  // /:id/dispatch). Stays null for a dealer's own purchase from a
  // supplier, and null for a retailer purchase that hasn't been placed yet.
  linkedSaleId Int?  @unique
  linkedSale   Sale? @relation(fields: [linkedSaleId], references: [id])
}

// Each line item captures the batch-specific details of what was actually
// bought: cost, selling price, discount, MRP, dates, and batch name. These
// used to live on Product itself, but a re-order of the same product can
// arrive with different pricing/dates/batch, so they belong here instead.
//
// A DEALER buying from a supplier fills all of the fields below in
// directly on the purchase form. A RETAILER buying from their own dealer
// no longer enters any of this (see Purchases.jsx) — they only pick a
// product and quantity, so these stay null until the dealer dispatches the
// linked Sale and the fulfilling Inventory batch's values get copied
// across (see sales.js PATCH /:id/dispatch). At that point they're
// populated exactly like a dealer's own purchase, so the existing
// RECEIVED-time inventory-crediting logic in purchases.js works unchanged
// either way.
model PurchaseItem {
  id                   Int       @id @default(autoincrement())
  purchaseId           Int
  purchase             Purchase  @relation(fields: [purchaseId], references: [id])
  productId            Int
  product              Product   @relation(fields: [productId], references: [id])
  quantity             Int
  // Snapshot of `quantity` taken when this line was (re)declared — set at
  // POST / and PUT /:id (a full resubmission of the purchase form), and
  // left untouched by PATCH /:id/quantities (the surgical quantity-only
  // correction). That split is the whole point: comparing quantity against
  // originalQuantity is how the UI flags a line that's since drifted from
  // what was first asked for — see Purchases.jsx and Sales.jsx. Defaults to
  // 0 purely so the column can be added to an existing table without a
  // manual backfill migration; every row created through the app (POST /
  // and PUT /:id) always sets it explicitly to match quantity, so a real
  // 0 should never actually appear outside of old pre-migration rows.
  originalQuantity     Int       @default(0)
  rate                 Decimal?  @db.Decimal(10, 2) // cost price paid per unit for this batch
  dealerCommission     Decimal?  @db.Decimal(5, 2) // dealer commission %, used to derive sellingPrice
  sellingPrice         Decimal?  @db.Decimal(10, 2) // = rate + (dealerCommission * rate / 100), rounded to 1 decimal
  discount             Decimal   @default(0) @db.Decimal(10, 2) // product discount %, used to derive retailerSellingPrice
  mrp                  Decimal?  @db.Decimal(10, 2)
  retailerSellingPrice Decimal?  @db.Decimal(10, 2) // = mrp - (discount * mrp / 100), rounded to 2 decimals
  manufacturingDate    DateTime?
  expiryDate           DateTime?
  batchName            String?

  saleItem SaleItem? // inverse of SaleItem.purchaseItemId, for a retailer-order line
}

// ---------------- Sales / POS ----------------
model Sale {
  id                 Int          @id @default(autoincrement())
  ownerType          OwnerType
  dealerId           Int?
  retailerId         Int?
  dealer             Dealer?      @relation("DealerSales", fields: [dealerId], references: [id])
  retailer           Retailer?    @relation("RetailerSales", fields: [retailerId], references: [id])
  customerType       CustomerType
  customerRetailerId Int? // when dealer sells to a retailer
  date               DateTime     @default(now())
  // COMPLETED for every ordinary POS sale. IN_PENDING / DISPATCHED only
  // apply to a Sale auto-created from a retailer's purchase order — see
  // SaleStatus above.
  status             SaleStatus   @default(COMPLETED)
  totalAmount        Decimal?     @db.Decimal(10, 2) // null until DISPATCHED for an order-linked Sale
  paymentMode        PaymentMode? // null until DISPATCHED for an order-linked Sale
  posTransactionRef  String?
  items              SaleItem[]

  // Inverse of Purchase.linkedSale — set when this Sale was auto-created
  // from a retailer's purchase order rather than entered directly at POS.
  linkedPurchase Purchase?
}

model SaleItem {
  id               Int      @id @default(autoincrement())
  saleId           Int
  sale             Sale     @relation(fields: [saleId], references: [id])
  productId        Int
  product          Product  @relation(fields: [productId], references: [id])
  quantity         Int
  // Copied from the originating PurchaseItem.originalQuantity when this line
  // is created (see purchases.js PATCH /:id/status, ORDERED transition).
  // Null for an ordinary POS sale item, which has no retailer order behind
  // it. Stays fixed while `quantity` may be corrected before dispatch (see
  // sales.js PATCH /:id/items) — the dealer can fulfil for less than what
  // was ordered but never more; see Sales.jsx for the max-quantity guard
  // and the different-quantity highlight this makes possible.
  //
  // Deliberately stays nullable with NO default (unlike PurchaseItem's) —
  // defaulting this to 0 would make every ordinary POS sale item register
  // as "changed" (0 != quantity) and light up amber on Sales.jsx for no
  // reason. Null genuinely means "not applicable" here, not "unset".
  originalQuantity Int?
  // Null until a batch is chosen for this line — see Sale.status /
  // sales.js PATCH /:id/dispatch. Always set immediately for an ordinary
  // POS sale (createSale resolves it from the chosen Inventory batch
  // before the Sale/SaleItem rows are even created).
  price            Decimal? @db.Decimal(10, 2)
  discount         Decimal  @default(0) @db.Decimal(10, 2)
  // Snapshot of MRP from the Inventory batch at sale time — printed on the
  // bill alongside the sale price so "you saved" can be shown per line.
  mrp              Decimal? @db.Decimal(10, 2)
  // Snapshot of which Inventory batch this line was sold from, captured at
  // sale time — printed on the bill for traceability. Not a live FK to
  // Inventory, since that row's quantity keeps changing after the sale.
  batchName        String?

  // Set only for a line that mirrors a retailer's purchase-order item
  // (see purchases.js PATCH /:id/status, ORDERED transition). Lets
  // sales.js PATCH /:id/dispatch backfill the originating PurchaseItem's
  // pricing/batch fields directly by id, rather than matching on
  // productId (which could be ambiguous if a purchase has two lines for
  // the same product).
  purchaseItemId Int?          @unique
  purchaseItem   PurchaseItem? @relation(fields: [purchaseItemId], references: [id])
}

// ---------------- Vouchers (Dealer <-> Retailer/Supplier) ----------------
// type RECEIVABLE: retailerId is set, supplierId is null (dealer sold to
// retailer — see sales.js createSale/dispatch, unchanged from before).
// type PAYABLE: supplierId is set, retailerId is null (dealer bought from
// supplier — see purchases.js PATCH /:id/status, CONFIRMED transition).
// dealerId is always set either way, since every voucher is on some
// dealer's books.
model Voucher {
  id          Int           @id @default(autoincrement())
  type        VoucherType   @default(RECEIVABLE)
  dealerId    Int
  dealer      Dealer        @relation(fields: [dealerId], references: [id])
  retailerId  Int?
  retailer    Retailer?     @relation(fields: [retailerId], references: [id])
  supplierId  Int?
  supplier    Supplier?     @relation(fields: [supplierId], references: [id])
  amount      Decimal       @db.Decimal(10, 2)
  description String?
  date        DateTime      @default(now())
  status      VoucherStatus @default(OPEN)
  receipts    Receipt[]
  payments    Payment[]
}

// ---------------- Receipts (money received against vouchers) ----------------
// A retailer's payment (receipts.js POST /) creates this row as
// TO_BE_CONFIRMED and does NOT touch the parent Voucher's status — the
// voucher is left exactly as it was until the dealer confirms. The dealer
// confirming (PATCH /:id/confirm) is what actually settles anything: it
// computes whether this receipt (plus any already-confirmed receipts
// against the same voucher) covers the voucher in full or only in part,
// stamps this row PAID or PARTIALLY_PAID accordingly, and pushes that
// same status onto the Voucher.
model Receipt {
  id          Int           @id @default(autoincrement())
  voucherId   Int
  voucher     Voucher       @relation(fields: [voucherId], references: [id])
  retailerId  Int
  retailer    Retailer      @relation(fields: [retailerId], references: [id])
  // The Payment row created in the same transaction as this Receipt (see
  // receipts.js POST /) — the real ledger entry this receipt is the
  // confirmation-workflow wrapper around. One-to-one; nullable since
  // receipts created before this change have no linked Payment.
  paymentId   Int?          @unique
  payment     Payment?      @relation(fields: [paymentId], references: [id])
  amount      Decimal       @db.Decimal(10, 2)
  mode        PaymentMode
  status      ReceiptStatus @default(TO_BE_CONFIRMED)
  confirmedAt DateTime?
  date        DateTime      @default(now())
}

// ---------------- Payments (Dealer -> Manufacturer, Dealer -> Supplier
// against a PAYABLE voucher, or Retailer -> Dealer against a RECEIVABLE
// voucher) ----------------
// voucherId/supplierId/retailerId all stay null for the original generic
// dealer -> manufacturer payment (nothing here changes for that use). When
// supplierId is set, this is money the dealer paid a specific supplier
// against one of their PAYABLE vouchers (see purchases.js). When
// retailerId is set instead, this is money a retailer paid the dealer
// against one of their RECEIVABLE vouchers, created alongside a Receipt
// (see receipts.js) — the confirmation-workflow wrapper around it.
model Payment {
  id         Int         @id @default(autoincrement())
  dealerId   Int
  dealer     Dealer      @relation(fields: [dealerId], references: [id])
  supplierId Int?
  supplier   Supplier?   @relation(fields: [supplierId], references: [id])
  // Set when this Payment is a retailer paying the dealer (the RECEIVABLE-
  // voucher direction — created alongside a Receipt in receipts.js POST /)
  // rather than the dealer paying a supplier (the PAYABLE-voucher
  // direction, supplierId above). Exactly one of supplierId / retailerId
  // should be set on any given Payment, mirroring Voucher.type.
  retailerId Int?
  retailer   Retailer?   @relation(fields: [retailerId], references: [id])
  voucherId  Int?
  voucher    Voucher?    @relation(fields: [voucherId], references: [id])
  amount     Decimal     @db.Decimal(10, 2)
  mode       PaymentMode
  reference  String?
  date       DateTime    @default(now())

  // Inverse of Receipt.paymentId — the Receipt created in the same
  // transaction as this Payment when it's the retailer -> dealer
  // direction. Null for every other Payment (dealer -> supplier, or the
  // original generic dealer -> manufacturer payment).
  receipt    Receipt?
}

// ============================================================
// Generic RBAC layer (roles / activities / mapping) + Organisation
// Mirrors: mahamandal.json, user_roles.json, activities.json,
// role_activity_mapping.json
// ============================================================

// Apex / franchising body that owns the whole deployment (Mahamandal).
// Kept separate from Dealer/Retailer so one deployment can later be
// white-labelled per organisation.
model Organisation {
  orgId      Int      @id @default(autoincrement())
  orgName    String
  orgAddress String
  orgContact String
  orgType    String   @default("MAHAMANDAL")
  createdAt  DateTime @default(now())

  dealers Dealer[]
  users   User[]
}

// Roles from user_roles.json: Super User, Administrator, Owner, User
model UserRole {
  roleId    Int      @id @default(autoincrement())
  roleName  String   @unique
  createdAt DateTime @default(now())

  mappings RoleActivityMapping[]
}

// Activities (app modules/permissions) from activities.json
model Activity {
  activityId   Int      @id @default(autoincrement())
  activityName String   @unique
  createdAt    DateTime @default(now())

  mappings RoleActivityMapping[]
}

// Which roles are allowed to perform which activities
model RoleActivityMapping {
  mappingId  Int      @id @default(autoincrement())
  roleId     Int
  activityId Int
  role       UserRole @relation(fields: [roleId], references: [roleId])
  activity   Activity @relation(fields: [activityId], references: [activityId])
  iactive    Boolean  @default(true)
  createdAt  DateTime @default(now())

  @@unique([roleId, activityId])
}

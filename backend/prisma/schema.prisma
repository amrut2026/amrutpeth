// ============================================================
// FoodMart PoC - Prisma schema (PostgreSQL)
// Run: npx prisma migrate dev --name receipt_confirmation_workflow
// ============================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN // manufacturer / platform owner
  ORGANISATION // login tied to an Organisation (Mahamandal/Federation/Association) itself
  DEALER
  RETAILER
}

enum OwnerType {
  DEALER
  RETAILER
}

enum PaymentMode {
  CASH
  UPI
  CARD
}

enum CustomerType {
  CASH
  RETAILER
}

enum VoucherStatus {
  OPEN
  PARTIALLY_PAID
  PAID
}

// A Receipt starts TO_BE_CONFIRMED the moment a retailer submits a payment
// (see receipts.js POST /) and only becomes PARTIALLY_PAID or PAID once
// the dealer confirms it actually arrived (PATCH /:id/confirm) — mirrors
// the terminal values of VoucherStatus deliberately (the receipt's final
// status and the voucher's resulting status are set to the same value in
// that same confirm step), but is a separate enum because a Receipt can
// additionally sit in the pending TO_BE_CONFIRMED state, which a Voucher
// itself never does.
enum ReceiptStatus {
  TO_BE_CONFIRMED
  PARTIALLY_PAID
  PAID
}

// RECEIVABLE: dealer -> retailer (retailer owes the dealer for a sale, see
// sales.js). PAYABLE: supplier -> dealer (dealer owes the supplier for a
// purchase, see purchases.js) — mirrors a RECEIVABLE voucher from the
// supplier's side (supplier "sold", dealer "bought"), but is always raised
// already PAID: the dealer is assumed to settle with the supplier directly
// and hand back a receipt outside this system, so there's no Receipt-style
// confirmation step for this type (Receipt stays scoped to retailers only).
enum VoucherType {
  RECEIVABLE
  PAYABLE
}

// Purchase review workflow forks by role after IN_REVIEW:
//   DEALER (buying from a supplier):     PENDING -> IN_REVIEW -> CONFIRMED
//   RETAILER (buying from their dealer): PENDING -> IN_REVIEW -> ORDERED
//     -> IN_TRANSIT -> RECEIVED
// ORDERED means the retailer has placed the order — a mirror row is created
// in the dealer's own Sale table at that point (see Purchase.linkedSale)
// so it shows up in their normal sales workflow. IN_TRANSIT means the
// dealer has dispatched it: their own inventory has already been
// decremented, via the linked Sale's dispatch (see sales.js PATCH
// /:id/dispatch) — that route is the only thing allowed to make this
// transition, since it also requires picking a batch per item. RECEIVED is
// the terminal state where the retailer's own inventory finally gets
// credited (see purchases.js PATCH /:id/status).
enum PurchaseStatus {
  PENDING
  IN_REVIEW
  CONFIRMED
  ORDERED
  IN_TRANSIT
  RECEIVED
  // A DEALER's own purchase, already CONFIRMED, that's since had its
  // pricing corrected via PATCH /:id/prices — inventory/vouchers/downstream
  // sales are cascaded to match, but the purchase itself is flagged so it's
  // visibly distinct from an untouched CONFIRMED purchase. Never applies to
  // a RETAILER's own purchase (that side has no price-correction route).
  MODIFIED
}

// A regular POS sale (walk-in cash sale, a dealer selling on the spot to a
// retailer, or a card/UPI terminal webhook) completes immediately and is
// COMPLETED from the moment it's created — every Sale made directly
// through sales.js's createSale() is this. IN_PENDING and DISPATCHED only
// apply to a Sale that was auto-created from a retailer's purchase order
// once it reaches ORDERED (see PurchaseStatus / Purchase.linkedSale):
// IN_PENDING while it's waiting on the dealer to fulfil it (no batch
// chosen yet, totalAmount/paymentMode are still null), DISPATCHED once the
// dealer has picked a batch per item and their inventory has been
// decremented.
enum SaleStatus {
  COMPLETED
  IN_PENDING
  DISPATCHED
}

// OPEN the moment a CASH-sale line item is recorded (see sales.js
// createSale), PAID once the seller settles up with their own
// dealer/supplier for it (see soldProducts.js POST /pay).
// A SoldProduct row settled by a RETAILER (owedBy: RETAILER) starts
// TO_BE_CONFIRMED the moment they submit a payment (see soldProducts.js
// POST /pay) and only becomes PAID once their dealer confirms it actually
// arrived (PATCH /sold-products/pay/:paymentId/confirm) — mirrors
// ReceiptStatus's confirmation step deliberately. A DEALER's own
// settlement to their supplier — both their own cash sales (owedBy:
// DEALER, dealerId: null) and the second, dealer-owed-to-supplier row for
// stock a retailer resold (owedBy: DEALER, dealerId set) — is always
// marked PAID directly with no confirmation step, same as a PAYABLE
// Voucher.
enum SoldProductStatus {
  OPEN
  TO_BE_CONFIRMED
  PAID
}

// ---------------- Users / Auth ----------------
model User {
  id             Int           @id @default(autoincrement())
  username       String        @unique
  password       String // bcrypt hash
  role           Role
  dealerId       Int?
  retailerId     Int?
  organisationId Int?
  dealer         Dealer?       @relation(fields: [dealerId], references: [id])
  retailer       Retailer?     @relation(fields: [retailerId], references: [id])
  organisation   Organisation? @relation(fields: [organisationId], references: [orgId])
  createdAt      DateTime      @default(now())
}

// ---------------- Divisions (geographic/business areas) ----------------
// Used to group dealers and suppliers/manufacturers by area of establishment.
model Division {
  id          Int      @id @default(autoincrement())
  name        String   @unique
  description String?
  // Soft-delete flag — divisions are never hard-deleted (dealers/suppliers
  // reference them), just deactivated. See divisions.js PATCH /:id/active.
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())

  dealers   Dealer[]
  suppliers Supplier[]
}

// ---------------- Dealer ----------------
model Dealer {
  id             Int          @id @default(autoincrement())
  name           String
  address        String
  contactNumber  String
  // Optional — a dealer may not be GST-registered.
  gstNumber      String?
  divisionId     Int?
  division       Division?    @relation(fields: [divisionId], references: [id])
  organisationId Int          @default(1)
  organisation   Organisation @relation(fields: [organisationId], references: [orgId])
  createdAt      DateTime     @default(now())

  bankAccounts           DealerBankAccount[]
  retailers              Retailer[]
  users                  User[]
  products               Product[]
  productCategories      ProductCategory[]
  inventory              Inventory[]         @relation("DealerInventory")
  purchases              Purchase[]          @relation("DealerPurchases")
  purchasesFromRetailers Purchase[]          @relation("PurchaseFromDealer")
  sales                  Sale[]              @relation("DealerSales")
  vouchers               Voucher[]
  payments               Payment[]
  soldProductSettlements SoldProduct[]
}

model DealerBankAccount {
  id            Int    @id @default(autoincrement())
  dealerId      Int
  dealer        Dealer @relation(fields: [dealerId], references: [id])
  accountNumber String
  ifsc          String
  bankName      String
}

// ---------------- Retailer ----------------
model Retailer {
  id              Int      @id @default(autoincrement())
  name            String
  address         String
  contactNumber   String
  // Optional — a retailer may not be GST-registered.
  gstNumber       String?
  primaryDealerId Int
  dealer          Dealer   @relation(fields: [primaryDealerId], references: [id])
  createdAt       DateTime @default(now())

  bankAccounts RetailerBankAccount[]
  users        User[]
  inventory    Inventory[]           @relation("RetailerInventory")
  purchases    Purchase[]            @relation("RetailerPurchases")
  sales        Sale[]                @relation("RetailerSales")
  vouchers     Voucher[]
  receipts     Receipt[]
  payments     Payment[]
}

model RetailerBankAccount {
  id            Int      @id @default(autoincrement())
  retailerId    Int
  retailer      Retailer @relation(fields: [retailerId], references: [id])
  accountNumber String
  ifsc          String
  bankName      String
}

// ---------------- Product Catalog ----------------
// Categories are created by dealers and scoped to them — a DEALER only sees
// and manages their own categories, while ADMIN can see every dealer's
// categories (read-only) across the whole platform.
model ProductCategory {
  id           Int           @id @default(autoincrement())
  name         String
  description  String?
  // Tax rates in percent, applied to products under this category — e.g.
  // 2.5 means 2.5%. Defaulted to 2.5 each so a new category is usable
  // immediately without the dealer having to know the exact GST slab up
  // front; they're free to change it per category.
  cgst         Decimal       @default(2.5) @db.Decimal(5, 2)
  sgst         Decimal       @default(2.5) @db.Decimal(5, 2)
  dealerId     Int
  dealer       Dealer        @relation(fields: [dealerId], references: [id])
  products     Product[]
  productNames ProductName[]
  flavours     Flavour[]
}

// Curated vocabularies for the product creation form's Name and Size/Weight
// dropdowns — not a foreign key on Product itself (Product.name and
// Product.sizeWeight stay plain strings, unchanged, so every existing query
// that reads product.name/product.sizeWeight directly keeps working as-is).
// Purely a growing, de-duplicated list of values a dealer has already used,
// so the same product can't accidentally get created twice under slightly
// different spellings ("Refined Oil" vs "refined oil ").
//
// ProductName is scoped to a ProductCategory — a name only makes sense
// within the category it was created under (e.g. "Refined Oil" under
// Edible Oils), so the product form's Name dropdown only offers names
// belonging to whichever category is currently selected. Since
// ProductCategory itself is already dealer-scoped (see below), this
// transitively scopes ProductName to a single dealer's own categories too
// — there's no separate dealerId needed here. The same name string can
// still exist under more than one category as separate entries (@@unique
// is per-category, not global).
//
// Unit/sizeWeight has no such natural category tie ("1kg", "500ml" apply
// everywhere), so it stays a single flat list shared across every dealer.
// See products.js GET/POST /names, /units.
model ProductName {
  id         Int             @id @default(autoincrement())
  name       String
  categoryId Int
  category   ProductCategory @relation(fields: [categoryId], references: [id])
  createdAt  DateTime        @default(now())

  @@unique([categoryId, name])
}

model Unit {
  id        Int      @id @default(autoincrement())
  value     String   @unique
  createdAt DateTime @default(now())
}

// Same pattern as Unit — flat, global vocabularies with no category tie.
// A flavour ("Mango", "Original") or brand ("Tata") can reasonably apply
// under more than one category, unlike ProductName above.
model Flavour {
  id         Int             @id @default(autoincrement())
  value      String
  categoryId Int
  category   ProductCategory @relation(fields: [categoryId], references: [id])
  createdAt  DateTime        @default(now())

  @@unique([categoryId, value])
}

model Brand {
  id        Int      @id @default(autoincrement())
  value     String   @unique
  createdAt DateTime @default(now())
}

// Product master catalog. Created by dealers (see products.js POST / —
// DEALER only, dealerId always taken from the logged-in user, never the
// client) — each product belongs to exactly one dealer, and retailers may
// only purchase/sell it via their own primary dealer.
// Note: pricing, MRP, dates, and batch name are NOT here — those vary per
// batch purchased and live on PurchaseItem instead. The barcode identifies
// the product itself and stays the same across every purchase/batch.
model Product {
  id         Int             @id @default(autoincrement())
  categoryId Int
  category   ProductCategory @relation(fields: [categoryId], references: [id])
  supplierId Int?
  supplier   Supplier?       @relation(fields: [supplierId], references: [id])
  dealerId   Int // the dealer that created/owns this product — retailers may
  dealer     Dealer          @relation(fields: [dealerId], references: [id])
  // only purchase or sell it via that dealer, and other dealers can't see it
  // Free-text, but sourced from the ProductName/Unit/Flavour/Brand
  // dropdowns at creation time (see products.js) — not foreign keys, so
  // they stay ordinary strings here and every existing read of
  // product.name/sizeWeight is unaffected. See ProductName/Unit above for
  // why. flavour and brand are optional — not every product has either.
  name       String
  sizeWeight String
  flavour    String?
  brand      String?
  // Snapshot of the category's cgst/sgst (see ProductCategory) at the
  // moment this product is created — pre-filled from the selected
  // category in Products.jsx, but editable per product if that default
  // doesn't apply (e.g. an item taxed differently from its category's
  // usual rate). Not a live reference — changing the category's own rate
  // later doesn't retroactively change already-created products, same
  // reasoning as name/sizeWeight/flavour/brand above.
  cgst       Decimal         @default(2.5) @db.Decimal(5, 2)
  sgst       Decimal         @default(2.5) @db.Decimal(5, 2)
  fssaiCode  String
  barcode    String          @unique // encoded value for barcode/QR - stable, never regenerated

  createdAt     DateTime       @default(now())
  inventory     Inventory[]
  saleItems     SaleItem[]
  purchaseItems PurchaseItem[]
  soldProducts  SoldProduct[]

  // The same supplier+category+name+sizeWeight+flavour+brand combination is
  // one product — this is what "Clone to another supplier" (Products.jsx)
  // exists for, rather than letting the same item get re-entered under the
  // same supplier by mistake. flavour/brand are part of the key because two
  // flavour variants of the same base product (e.g. Mango vs Original) are
  // legitimately different products, not duplicates. Enforced here (not
  // just in products.js) so it holds regardless of entry path. supplierId
  // is nullable, and standard SQL unique-index semantics treat each NULL as
  // distinct from every other NULL — POST /products already requires a
  // supplierId, so this only matters for a product edited down to no
  // supplier, which stays unconstrained against other no-supplier products.
  // The same is true of flavour/brand being null.
  @@unique([supplierId, categoryId, name, sizeWeight, flavour, brand])
}

// Suppliers / manufacturers that dealers (or retailers) purchase stock from.
// Managed centrally by ADMIN.
model Supplier {
  id            Int       @id @default(autoincrement())
  name          String
  address       String
  contactNumber String
  // Optional — a supplier may not be GST-registered.
  gstNumber     String?
  divisionId    Int?
  division      Division? @relation(fields: [divisionId], references: [id])
  createdAt     DateTime  @default(now())

  bankAccounts SupplierBankAccount[]
  purchases    Purchase[]
  products     Product[]
  vouchers     Voucher[]
  payments     Payment[]
}

model SupplierBankAccount {
  id            Int      @id @default(autoincrement())
  supplierId    Int
  supplier      Supplier @relation(fields: [supplierId], references: [id])
  accountNumber String
  ifsc          String
  bankName      String
}

// ---------------- Inventory ----------------
// One row per product + owner + BATCH. A product with stock from two
// different accepted purchases (different batchName) now has two rows here,
// each with its own quantity and its own pricing/dates from that specific
// PurchaseItem (see purchases.js /:id/status, which upserts per batch
// instead of collapsing into a single row). This lets a seller choose which
// batch to sell from at sale time (see sales.js) rather than always selling
// at "whatever the latest purchase price was."
model Inventory {
  id           Int       @id @default(autoincrement())
  productId    Int
  product      Product   @relation(fields: [productId], references: [id])
  ownerType    OwnerType
  dealerId     Int?
  retailerId   Int?
  dealer       Dealer?   @relation("DealerInventory", fields: [dealerId], references: [id])
  retailer     Retailer? @relation("RetailerInventory", fields: [retailerId], references: [id])
  quantity     Int       @default(0)
  reorderLevel Int       @default(10)

  // -- pricing/batch fields, carried from this specific PurchaseItem --
  rate                 Decimal   @default(0) @db.Decimal(10, 2) // cost price paid per unit, this batch
  dealerCommission     Decimal   @default(0) @db.Decimal(5, 2) // % used to derive sellingPrice
  sellingPrice         Decimal   @default(0) @db.Decimal(10, 2) // dealer -> retailer price
  discount             Decimal   @default(0) @db.Decimal(10, 2) // % used to derive retailerSellingPrice
  mrp                  Decimal   @default(0) @db.Decimal(10, 2)
  retailerSellingPrice Decimal   @default(0) @db.Decimal(10, 2) // retailer -> end customer / dealer cash-sale price
  manufacturingDate    DateTime?
  expiryDate           DateTime?
  batchName            String    @default("")

  // Only ever set on a RETAILER-owned batch — carried from
  // PurchaseItem.originDealerRate when the purchase is marked RECEIVED (see
  // purchases.js). The dealer's own cost from THEIR supplier for this exact
  // batch, so that once the retailer resells it, the dealer's obligation to
  // their own supplier can be raised (see SaleItem.originDealerRate,
  // SoldProduct.owedBy). Null on every DEALER-owned batch — a dealer's own
  // `rate` field above already serves that purpose for their own stock.
  originDealerRate     Decimal?  @db.Decimal(10, 2)

  updatedAt DateTime @updatedAt

  // batchName is part of the identity now — same product+owner can have
  // multiple batch rows. batchName defaults to "" rather than being
  // nullable because Postgres treats NULLs as distinct for uniqueness
  // purposes, which would let duplicate "no batch" rows slip through.
  @@unique([productId, ownerType, dealerId, retailerId, batchName])
}

// ---------------- Purchases / Inwards ----------------
// supplierId is set when a DEALER buys from a manufacturer/supplier.
// sourceDealerId is set when a RETAILER buys from their primary dealer.
// Exactly one of the two is populated, depending on ownerType.
model Purchase {
  id             Int            @id @default(autoincrement())
  ownerType      OwnerType
  dealerId       Int?
  retailerId     Int?
  dealer         Dealer?        @relation("DealerPurchases", fields: [dealerId], references: [id])
  retailer       Retailer?      @relation("RetailerPurchases", fields: [retailerId], references: [id])
  supplierId     Int?
  supplier       Supplier?      @relation(fields: [supplierId], references: [id])
  sourceDealerId Int?
  sourceDealer   Dealer?        @relation("PurchaseFromDealer", fields: [sourceDealerId], references: [id])
  date           DateTime       @default(now())
  status         PurchaseStatus @default(PENDING)
  items          PurchaseItem[]

  // Set when this is a retailer's purchase order and it reaches ORDERED —
  // points at the mirror Sale row created in the source dealer's own Sale
  // table (see purchases.js PATCH /:id/status and sales.js PATCH
  // /:id/dispatch). Stays null for a dealer's own purchase from a
  // supplier, and null for a retailer purchase that hasn't been placed yet.
  linkedSaleId Int?  @unique
  linkedSale   Sale? @relation(fields: [linkedSaleId], references: [id])

  // Inverse of Voucher.purchaseId — the PAYABLE voucher auto-raised when
  // this purchase reached CONFIRMED (see purchases.js PATCH /:id/status).
  // Lets a later price correction (PATCH /:id/prices) find and recompute
  // the right voucher directly, instead of matching on the free-text
  // description. Null for a retailer's own purchase (never raises a
  // voucher of its own) and null before CONFIRMED.
  payableVoucher Voucher?
}

// Each line item captures the batch-specific details of what was actually
// bought: cost, selling price, discount, MRP, dates, and batch name. These
// used to live on Product itself, but a re-order of the same product can
// arrive with different pricing/dates/batch, so they belong here instead.
//
// A DEALER buying from a supplier fills all of the fields below in
// directly on the purchase form. A RETAILER buying from their own dealer
// no longer enters any of this (see Purchases.jsx) — they only pick a
// product and quantity, so these stay null until the dealer dispatches the
// linked Sale and the fulfilling Inventory batch's values get copied
// across (see sales.js PATCH /:id/dispatch). At that point they're
// populated exactly like a dealer's own purchase, so the existing
// RECEIVED-time inventory-crediting logic in purchases.js works unchanged
// either way.
model PurchaseItem {
  id                   Int       @id @default(autoincrement())
  purchaseId           Int
  purchase             Purchase  @relation(fields: [purchaseId], references: [id])
  productId            Int
  product              Product   @relation(fields: [productId], references: [id])
  quantity             Int
  // Snapshot of `quantity` taken when this line was (re)declared — set at
  // POST / and PUT /:id (a full resubmission of the purchase form), and
  // left untouched by PATCH /:id/quantities (the surgical quantity-only
  // correction). That split is the whole point: comparing quantity against
  // originalQuantity is how the UI flags a line that's since drifted from
  // what was first asked for — see Purchases.jsx and Sales.jsx. Defaults to
  // 0 purely so the column can be added to an existing table without a
  // manual backfill migration; every row created through the app (POST /
  // and PUT /:id) always sets it explicitly to match quantity, so a real
  // 0 should never actually appear outside of old pre-migration rows.
  originalQuantity     Int       @default(0)
  rate                 Decimal?  @db.Decimal(10, 2) // cost price paid per unit for this batch
  dealerCommission     Decimal?  @db.Decimal(5, 2) // dealer commission %, used to derive sellingPrice
  sellingPrice         Decimal?  @db.Decimal(10, 2) // = rate + (dealerCommission * rate / 100), rounded to 1 decimal
  discount             Decimal   @default(0) @db.Decimal(10, 2) // product discount %, used to derive retailerSellingPrice
  mrp                  Decimal?  @db.Decimal(10, 2)
  retailerSellingPrice Decimal?  @db.Decimal(10, 2) // = mrp - (discount * mrp / 100), rounded to 2 decimals
  manufacturingDate    DateTime?
  expiryDate           DateTime?
  batchName            String?

  // The DEALER's own cost price for this batch — what they originally paid
  // THEIR supplier — backfilled from the fulfilling Inventory.rate at
  // dispatch time (sales.js PATCH /:id/dispatch), same moment as
  // rate/sellingPrice/mrp above. Carried through to the retailer's own
  // Inventory once this purchase is marked RECEIVED (purchases.js), and
  // from there to the retailer's own SaleItem when they resell it — so the
  // dealer's obligation to THEIR supplier can be raised automatically once
  // the retailer sells the unit on (see SaleItem.originDealerRate,
  // SoldProduct.owedBy). Always null for a dealer's own purchase from a
  // supplier — only meaningful for a retailer's purchase from their dealer.
  originDealerRate     Decimal?  @db.Decimal(10, 2)

  saleItem SaleItem? // inverse of SaleItem.purchaseItemId, for a retailer-order line
}

// ---------------- Sales / POS ----------------
model Sale {
  id                 Int          @id @default(autoincrement())
  ownerType          OwnerType
  dealerId           Int?
  retailerId         Int?
  dealer             Dealer?      @relation("DealerSales", fields: [dealerId], references: [id])
  retailer           Retailer?    @relation("RetailerSales", fields: [retailerId], references: [id])
  customerType       CustomerType
  customerRetailerId Int? // when dealer sells to a retailer
  date               DateTime     @default(now())
  // COMPLETED for every ordinary POS sale. IN_PENDING / DISPATCHED only
  // apply to a Sale auto-created from a retailer's purchase order — see
  // SaleStatus above.
  status             SaleStatus   @default(COMPLETED)
  totalAmount        Decimal?     @db.Decimal(10, 2) // null until DISPATCHED for an order-linked Sale
  paymentMode        PaymentMode? // null until DISPATCHED for an order-linked Sale
  posTransactionRef  String?
  items              SaleItem[]

  // Inverse of Purchase.linkedSale — set when this Sale was auto-created
  // from a retailer's purchase order rather than entered directly at POS.
  linkedPurchase Purchase?

  // Inverse of Voucher.saleId — the RECEIVABLE voucher auto-raised for a
  // dealer -> retailer sale, whether a direct POS sale (createSale) or an
  // order fulfilled via dispatch. Lets a purchase price correction that
  // cascades into this sale (see purchases.js PATCH /:id/prices) find and
  // recompute the right voucher directly. Null for a CASH sale (no
  // voucher at all) and null before the voucher is raised.
  receivableVoucher Voucher?

  // One row per CASH-sale line item — see SoldProduct. Empty for a sale to
  // a RETAILER customer.
  soldProducts SoldProduct[]
}

model SaleItem {
  id               Int      @id @default(autoincrement())
  saleId           Int
  sale             Sale     @relation(fields: [saleId], references: [id])
  productId        Int
  product          Product  @relation(fields: [productId], references: [id])
  quantity         Int
  originalQuantity Int?
  price            Decimal? @db.Decimal(10, 2)
  discount         Decimal  @default(0) @db.Decimal(10, 2)
  mrp              Decimal? @db.Decimal(10, 2)
  batchName        String?

  // Snapshot of the fulfilling Inventory batch's rate (cost price paid to
  // the supplier) and sellingPrice (dealer's wholesale price to a
  // retailer), captured at the same moment price/mrp/batchName are set
  // (createSale, and sales.js PATCH /:id/dispatch). NOT this sale's own
  // price — `price` above is that. These exist so soldProducts.js can
  // settle what the seller owes their own upstream supplier/dealer (rate
  // for a DEALER seller, sellingPrice for a RETAILER seller) from a fixed
  // snapshot, rather than a live Inventory re-lookup that could have since
  // drifted if the batch was re-received at a different cost.
  rate             Decimal? @db.Decimal(10, 2)
  sellingPrice     Decimal? @db.Decimal(10, 2)

  // Only ever set on a RETAILER's own SaleItem, snapshotted from
  // Inventory.originDealerRate at sale time (createSale). The dealer's own
  // cost from THEIR supplier for this batch — lets soldProducts.js raise a
  // second, dealer-scoped settlement obligation (dealer -> supplier)
  // alongside the ordinary retailer -> dealer one (SaleItem.sellingPrice
  // above), whenever a retailer resells dealer-sourced stock for cash. See
  // SoldProduct.owedBy. Null for a dealer's own SaleItem — not applicable.
  originDealerRate Decimal? @db.Decimal(10, 2)

  purchaseItemId Int?          @unique
  purchaseItem   PurchaseItem? @relation(fields: [purchaseItemId], references: [id])

  soldProducts SoldProduct[]
}

// One or two rows per CASH-sale line item (see sales.js createSale —
// created only when customerType is CASH, never for a dealer -> retailer
// sale, which is already settled through the RECEIVABLE voucher/Receipt
// flow instead). Tracks what's still owed to an upstream party for stock
// that's since been sold to a walk-in customer — a periodic (e.g.
// weekly/monthly) settlement, not tied to the original purchase voucher
// amount.
//
// Two independent obligations can exist for the same SaleItem, which is
// why saleItemId is no longer @unique:
//  - owedBy: DEALER, dealerId: null / owedBy: RETAILER — the ordinary row,
//    always created: the seller (dealer or retailer) owes their own
//    immediate upstream party (supplier or dealer respectively) for what
//    they sold. Settles at SaleItem.rate (dealer) or .sellingPrice
//    (retailer).
//  - owedBy: DEALER, dealerId: <originating dealer> — only created
//    alongside a RETAILER's own row, when that retailer resold stock that
//    was originally dispatched from a dealer's own supplier-sourced batch
//    (SaleItem.originDealerRate is set). Represents what the ORIGINATING
//    dealer now owes THEIR OWN supplier for that same unit — a second,
//    independent settlement that rides on the retailer's Sale/SaleItem
//    (a dealer never has a Sale of their own for it), which is why dealerId
//    is stored explicitly here rather than read off the Sale relation.
//    Settles at SaleItem.originDealerRate. Shown in the dealer's own
//    sold-products list with a "Sold by retailer <name>" note.
//
// batchName, quantity, and price are deliberately NOT duplicated here —
// they're read from the linked SaleItem at payment time (see
// soldProducts.js), so they can never drift out of sync with the sale
// itself. saleItemId is the precise line this row is about; saleId and
// productId are carried alongside for convenient filtering/display without
// an extra join.
model SoldProduct {
  id         Int               @id @default(autoincrement())
  saleId     Int
  sale       Sale              @relation(fields: [saleId], references: [id])
  productId  Int
  product    Product           @relation(fields: [productId], references: [id])
  saleItemId Int
  saleItem   SaleItem          @relation(fields: [saleItemId], references: [id])
  status     SoldProductStatus @default(OPEN)
  // Set once paid — the Payment raised in soldProducts.js POST /pay that
  // settled this row (that Payment's dealerId/supplierId or
  // dealerId/retailerId identifies who it was paid to).
  paymentId  Int?
  payment    Payment?          @relation(fields: [paymentId], references: [id])
  createdAt  DateTime          @default(now())

  // Who owes this row's amount. See the two-row explanation above.
  owedBy   OwnerType
  // Only set for the second (originating-dealer) row kind — see above.
  dealerId Int?
  dealer   Dealer? @relation(fields: [dealerId], references: [id])

  @@unique([saleItemId, owedBy])
}

// ---------------- Vouchers (Dealer <-> Retailer/Supplier) ----------------
// type RECEIVABLE: retailerId is set, supplierId is null (dealer sold to
// retailer — see sales.js createSale/dispatch, unchanged from before).
// type PAYABLE: supplierId is set, retailerId is null (dealer bought from
// supplier — see purchases.js PATCH /:id/status, CONFIRMED transition).
// dealerId is always set either way, since every voucher is on some
// dealer's books.
model Voucher {
  id          Int           @id @default(autoincrement())
  type        VoucherType   @default(RECEIVABLE)
  dealerId    Int
  dealer      Dealer        @relation(fields: [dealerId], references: [id])
  retailerId  Int?
  retailer    Retailer?     @relation(fields: [retailerId], references: [id])
  supplierId  Int?
  supplier    Supplier?     @relation(fields: [supplierId], references: [id])
  amount      Decimal       @db.Decimal(10, 2)
  description String?
  date        DateTime      @default(now())
  status      VoucherStatus @default(OPEN)
  receipts    Receipt[]
  payments    Payment[]

  // Set only for a PAYABLE voucher auto-raised from a dealer's own
  // purchase (see purchases.js PATCH /:id/status, CONFIRMED transition) —
  // lets a later price correction on that purchase find this voucher
  // directly and recompute its amount (see PATCH /:id/prices).
  purchaseId Int?      @unique
  purchase   Purchase? @relation(fields: [purchaseId], references: [id])

  // Set only for a RECEIVABLE voucher auto-raised from a dealer -> retailer
  // Sale (direct POS or dispatch-fulfilled order) — same purpose as
  // purchaseId above, for the sale side of a price-correction cascade.
  saleId Int?  @unique
  sale   Sale? @relation(fields: [saleId], references: [id])
}

// ---------------- Receipts (money received against vouchers) ----------------
// A retailer's payment (receipts.js POST /) creates this row as
// TO_BE_CONFIRMED and does NOT touch the parent Voucher's status — the
// voucher is left exactly as it was until the dealer confirms. The dealer
// confirming (PATCH /:id/confirm) is what actually settles anything: it
// computes whether this receipt (plus any already-confirmed receipts
// against the same voucher) covers the voucher in full or only in part,
// stamps this row PAID or PARTIALLY_PAID accordingly, and pushes that
// same status onto the Voucher.
// A voucher-backed receipt (voucherId set) follows the normal retailer ->
// dealer confirmation workflow: created TO_BE_CONFIRMED the instant the
// retailer submits it (receipts.js POST /), and only becomes PAID or
// PARTIALLY_PAID once the dealer confirms (PATCH /:id/confirm), which is
// also the point the linked Voucher's own status gets updated.
//
// A sold-products settlement (voucherId null) has no voucher to run that
// same workflow against — soldProducts.js already runs its own, separate
// TO_BE_CONFIRMED -> PAID lifecycle directly on the SoldProduct rows (see
// SoldProductStatus). Running a second, independent TO_BE_CONFIRMED ->
// PAID cycle here on top of that would just be two confirmations for the
// same money, so this kind of Receipt is created already PAID, in the same
// step the dealer confirms the underlying SoldProduct rows (PATCH
// /sold-products/pay/:paymentId/confirm) — purely so it shows up
// alongside voucher receipts in the retailer's payment history, not as a
// pending item needing its own confirmation.
model Receipt {
  id          Int           @id @default(autoincrement())
  voucherId   Int?
  voucher     Voucher?      @relation(fields: [voucherId], references: [id])
  retailerId  Int
  retailer    Retailer      @relation(fields: [retailerId], references: [id])
  // The Payment row created in the same transaction as this Receipt (see
  // receipts.js POST / and soldProducts.js PATCH /pay/:paymentId/confirm)
  // — the real ledger entry this receipt is the confirmation-workflow
  // wrapper (or, for a sold-products settlement, just the display record)
  // around. One-to-one; nullable since receipts created before this change
  // have no linked Payment.
  paymentId   Int?          @unique
  payment     Payment?      @relation(fields: [paymentId], references: [id])
  amount      Decimal       @db.Decimal(10, 2)
  mode        PaymentMode
  status      ReceiptStatus @default(TO_BE_CONFIRMED)
  confirmedAt DateTime?
  date        DateTime      @default(now())
}

// ---------------- Payments (Dealer -> Manufacturer, Dealer -> Supplier
// against a PAYABLE voucher, or Retailer -> Dealer against a RECEIVABLE
// voucher) ----------------
// voucherId/supplierId/retailerId all stay null for the original generic
// dealer -> manufacturer payment (nothing here changes for that use). When
// supplierId is set, this is money the dealer paid a specific supplier
// against one of their PAYABLE vouchers (see purchases.js). When
// retailerId is set instead, this is money a retailer paid the dealer
// against one of their RECEIVABLE vouchers, created alongside a Receipt
// (see receipts.js) — the confirmation-workflow wrapper around it.
model Payment {
  id         Int         @id @default(autoincrement())
  dealerId   Int
  dealer     Dealer      @relation(fields: [dealerId], references: [id])
  supplierId Int?
  supplier   Supplier?   @relation(fields: [supplierId], references: [id])
  // Set when this Payment is a retailer paying the dealer (the RECEIVABLE-
  // voucher direction — created alongside a Receipt in receipts.js POST /)
  // rather than the dealer paying a supplier (the PAYABLE-voucher
  // direction, supplierId above). Exactly one of supplierId / retailerId
  // should be set on any given Payment, mirroring Voucher.type.
  retailerId Int?
  retailer   Retailer?   @relation(fields: [retailerId], references: [id])
  voucherId  Int?
  voucher    Voucher?    @relation(fields: [voucherId], references: [id])
  amount     Decimal     @db.Decimal(10, 2)
  mode       PaymentMode
  reference  String?
  date       DateTime    @default(now())

  // Inverse of Receipt.paymentId — the Receipt created in the same
  // transaction as this Payment when it's the retailer -> dealer
  // direction. Null for every other Payment (dealer -> supplier, or the
  // original generic dealer -> manufacturer payment).
  receipt    Receipt?

  // Every SoldProduct row this Payment settled — set when this Payment was
  // raised via soldProducts.js POST /pay rather than the ordinary
  // voucher/receipt flow above.
  soldProducts SoldProduct[]
}

// ============================================================
// Generic RBAC layer (roles / activities / mapping) + Organisation
// Mirrors: mahamandal.json, user_roles.json, activities.json,
// role_activity_mapping.json
// ============================================================

// Apex / franchising body that owns the whole deployment (Mahamandal).
// Kept separate from Dealer/Retailer so one deployment can later be
// white-labelled per organisation.
model Organisation {
  orgId      Int      @id @default(autoincrement())
  orgName    String
  orgAddress String
  orgContact String
  orgType    String   @default("MAHAMANDAL")
  createdAt  DateTime @default(now())

  dealers Dealer[]
  users   User[]
}

// Roles from user_roles.json: Super User, Administrator, Owner, User
model UserRole {
  roleId    Int      @id @default(autoincrement())
  roleName  String   @unique
  createdAt DateTime @default(now())

  mappings RoleActivityMapping[]
}

// Activities (app modules/permissions) from activities.json
model Activity {
  activityId   Int      @id @default(autoincrement())
  activityName String   @unique
  createdAt    DateTime @default(now())

  mappings RoleActivityMapping[]
}

// Which roles are allowed to perform which activities
model RoleActivityMapping {
  mappingId  Int      @id @default(autoincrement())
  roleId     Int
  activityId Int
  role       UserRole @relation(fields: [roleId], references: [roleId])
  activity   Activity @relation(fields: [activityId], references: [activityId])
  iactive    Boolean  @default(true)
  createdAt  DateTime @default(now())

  @@unique([roleId, activityId])
}

# Supabase gives you connection strings under Settings > Database > Connection string.
# IMPORTANT — IPv4 vs IPv6: Supabase's raw "direct connection" host
# (db.<project-ref>.supabase.co:5432) is IPv6-only unless you pay for the IPv4
# add-on. Most home/corporate/PoC networks are IPv4-only, so use the POOLER
# hostname for BOTH variables below — it supports IPv4:
#   - DATABASE_URL -> Transaction pooler, port 6543, add ?pgbouncer=true
#   - DIRECT_URL   -> Session pooler, port 5432, no pgbouncer param
# Don't hand-edit the username — it must be "postgres.<project-ref>" for the
# pooler. URL-encode any special characters in your password (@ # % etc.).

DATABASE_URL="postgresql://postgres.<project-ref>:<password>@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.<project-ref>:<password>@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres"

# (Neon or Railway users: their default connection strings are IPv4-compatible
# already — just use the single string for both vars.)

JWT_SECRET="change-this-to-a-long-random-string"
PORT=4000
CORS_ORIGIN="http://localhost:5173"
